INFINITY_ENV=development
INFINITY_STORAGE_DIR=./storage
INFINITY_MAX_UPLOAD_MB=250
INFINITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,https://rdzoagbe.github.io

# Auth: required | optional | disabled  (see backend/app/auth.py)
INFINITY_AUTH_MODE=optional
# Supabase JWT verification — set at least one on Railway before beta invites:
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# Durable file storage (STRONGLY recommended before beta invites):
# with both SUPABASE_URL and SUPABASE_SERVICE_KEY set, audio files and the
# metadata store are mirrored to the Supabase Storage bucket below and
# survive backend redeploys. Service key: Supabase -> Settings -> API ->
# service_role (secret!). Never expose it to the frontend.
SUPABASE_SERVICE_KEY=
INFINITY_STORAGE_BUCKET=infinity-audio

# Signed download URLs (falls back to the JWT secret, or a random per-boot key)
INFINITY_SIGNING_SECRET=
INFINITY_DOWNLOAD_TTL_SECONDS=604800

# Limits & retention
INFINITY_MAX_USER_STORAGE_MB=2048
INFINITY_RATE_LIMIT_PER_MINUTE=20
INFINITY_FILE_TTL_DAYS=30

# AI integrations (server-side only)
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
